<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for Mewrk.app's own executable when the bundle is signed with the hardened runtime
  (scripts/bundle-macos.sh, with a signing identity). The Chromium helpers get their own, narrower sets there.

  - allow-jit / allow-unsigned-executable-memory: Chromium's browser process, which runs inside this executable,
    generates code at run time.
  - disable-library-validation: the Chromium Embedded Framework is loaded from the bundle; a signature without a Team ID
    would otherwise refuse it.
  - automation.apple-events, device.audio-input, device.camera: programs the user runs in Mewrk ask for these as Mewrk; the
    hardened runtime denies them outright without the entitlement, before macOS can ask the user. No App Sandbox: Mewrk is a
    development environment and must reach the user's projects and tools.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
</dict>
</plist>
