node_modules/
dist/
.pnpm-store/
src-tauri/gen/

# Local environment files may contain machine-specific endpoints or secrets.
/.env
/.env.*
!/.env.example
!/.env.*.example

# Cargo output, including the ad-hoc CARGO_TARGET_DIR runs kept at the repo root.
target/
target-*/
*.rmeta


# 形式化验证工具链（ProB CLI + TLA2B.jar + 便携 JRE）：每台开发机
# `npm run prob:fetch` 装配；钉版住在 scripts/prob-fetch.mjs。
/tools/
.prob-cache/

# Bitmap trace the icon set was drawn from; the shipped icon sources live in src/.
/logo.svg

# Scratch space used by local agent/e2e runs.
.codex-tmp/
__pycache__/
.cargo/

# Machine-local Claude Code knowledge and global configuration mirrors.
/.claude/memory/
/.claude/global/
/.claude/README.md

# Local scratch space for one-off investigation artifacts, which can be large and
# are never part of project history.
scratchpad/

# Claude Code runtime state; project launch and hook configuration stay tracked.
.claude/settings.local.json
.claude/worktrees/

*.log
.DS_Store
.idea/
.vscode/
coverage/
.repro-*.mjs

# TypeScript incremental build info.
*.tsbuildinfo

# probcli 在 TLA 源旁生成的解析缓存（formal/tla/ 的非源文件）
formal/tla/*.prob
formal/tla/*_tla.txt

# ProB CSP parser cache generated beside the source specification.
formal/csp/*.csp.pl

# deepseek API key
key.txt

# AI SDK 迁移期的临时脚本与日志。
.aisdk-tmp/

# Remote agent builds staged by `npm run build:remote-agents`, one directory per
# target triple: `--release` builds every target into remote-agents/ for
# `npm run publish:components`; `--bundle` stages only the platform being built
# into bundled-agents/, the one build the installer carries.
/src-tauri/remote-agents/
/src-tauri/bundled-agents/

# Retired sidecar staging. `src-tauri/build.rs` used to copy the 90 MiB AI SDK sidecar
# and Claude Code here for `externalBin`; neither ships in the installer now (the app
# fetches the sidecar from Mewrk's component channel, the Claude Agent SDK and CLI are
# installed from npm on the provider page). Kept so a checkout that still has the
# directory from before stays clean.
/src-tauri/binaries/

# Icons src-tauri/build.rs renders for non-Windows targets from the same SVGs as the
# tracked icon.ico: the window icon generate_context! opens, and the macOS bundle icon.
/src-tauri/icons/icon.png
/src-tauri/icons/icon.icns

# Development documentation stays local; the public repository ships the README only.
# docs/context-injections is exempt: the Rust golden test builtin_schema_baseline_is_current
# reads builtin-tool-schemas.json from disk, so those generated exports must stay tracked.
/docs/*
!/docs/context-injections/
/docs/context-injections/host-context-templates.md
/HANDOFF-*.md

# Machine-local agent-workflow instructions and per-tool configuration.
/CLAUDE.md
/AGENTS.md
/.claude/
/.codex/

# Generated Tauri ACL permission manifests; build.rs regenerates them on every build.
/src-tauri/permissions/autogenerated/

# macOS only: the Chromium Embedded Framework distribution cef-dll-sys fetches when
# the build scripts point CEF_PATH here (see scripts/cef-environment.mjs).
/.cef/
/.mlx/

# Runtime databases and machine-local application state.
/src-tauri/conversations.v1*.sqlite3*
/src-tauri/token-usage.v1.sqlite3*
/.mewrk/

# SEA build output rewritten by aisdk-service/build.mjs on every sidecar build.
/aisdk-service/sea-config.json
