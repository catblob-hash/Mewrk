{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBundleCommand": "node scripts/stage-macos-cef.mjs && node scripts/stage-macos-mlx.mjs && node scripts/sign-macos-remote-agents.mjs"
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md",
      "../THIRD-PARTY-LICENSES.md": "THIRD-PARTY-LICENSES.md"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "InfoPlist/en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "InfoPlist/zh-Hans.lproj/InfoPlist.strings",
        "Resources/CHROMIUM-CREDITS.html": "target/cef-bundle/CHROMIUM-CREDITS.html",
        "Resources/CEF-LICENSE.txt": "target/cef-bundle/CEF-LICENSE.txt",
        "Frameworks/Chromium Embedded Framework.framework": "target/cef-bundle/Chromium Embedded Framework.framework",
        "Frameworks/Mewrk Helper.app": "target/cef-bundle/Mewrk Helper.app",
        "Frameworks/Mewrk Helper (GPU).app": "target/cef-bundle/Mewrk Helper (GPU).app",
        "Frameworks/Mewrk Helper (Renderer).app": "target/cef-bundle/Mewrk Helper (Renderer).app",
        "Frameworks/Mewrk Helper (Plugin).app": "target/cef-bundle/Mewrk Helper (Plugin).app",
        "Frameworks/Mewrk Helper (Alerts).app": "target/cef-bundle/Mewrk Helper (Alerts).app",
        "Frameworks/mewrk-mlx": "target/mlx-bundle"
      }
    }
  }
}
